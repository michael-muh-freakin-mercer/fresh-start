{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "bright_cyan",
      "2": "cyan",
      "3": "blue",
      "4": "magenta",
      "5": "red"
    },
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true,
    "separator": " ▸ ",
    "color": {
      "separator": "90"
    },
    "bar": {
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "width": 10
    },
    "percent": {
      "type": ["bar", "num"],
      "ndigits": 0
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "   OPERATOR",
      "keyColor": "bright_cyan",
      "format": "{#1;36}{user-name}{#90}@{#1;35}{host-name}{#90}  [{#1;32}ONLINE{#90}]"
    },
    {
      "type": "custom",
      "format": "{#90}╭─[{#1;32}   HARDWARE // TELEMETRY {#90}]───────────────────────╮"
    },
    {
      "type": "host",
      "key": "│ ├ Machine ",
      "keyColor": "green",
      "format": "{version} {#90}({name})"
    },
    {
      "type": "cpu",
      "key": "│ ├ CPU     ",
      "showPeCoreCount": true,
      "temp": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├ GPU     ",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󱄄 Display ",
      "keyColor": "green",
      "format": "{width}x{height} @ {refresh-rate}Hz {#90}({inch}\" {type})"
    },
    {
      "type": "memory",
      "key": "│ ├ Memory  ",
      "keyColor": "green",
      "format": "{percentage-bar} {percentage} {#90}({used} / {total})"
    },
    {
      "type": "battery",
      "key": "│ ├ Battery ",
      "keyColor": "green",
      "format": "{capacity-bar} {capacity} {#90}[{status}]"
    },
    {
      "type": "disk",
      "key": "│ └󰋊 Storage ",
      "folders": "/",
      "keyColor": "green",
      "format": "{size-percentage-bar} {size-percentage} {#90}({size-used} / {size-total} • {filesystem})"
    },
    {
      "type": "custom",
      "format": "{#90}╰────────────────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "{#90}╭─[{#1;34}   SOFTWARE // OMARCHY {#90}]─────────────────────────╮"
    },
    {
      "type": "command",
      "key": "│ ├\ue900 System  ",
      "keyColor": "blue",
      "text": "echo \"Omarchy $(omarchy-version) ($(omarchy-version-channel))\""
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel  ",
      "keyColor": "blue",
      "format": "{sysname} {release} {#90}({arch})"
    },
    {
      "type": "wm",
      "key": "│ ├ WM      ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├ Term    ",
      "keyColor": "blue",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "│ ├ Shell   ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 Pkgs    ",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ └󰸌 Theme   ",
      "keyColor": "blue",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme  \\e[31m● \\e[32m● \\e[33m● \\e[34m● \\e[35m● \\e[36m● \\e[37m● \\e[90m●\""
    },
    {
      "type": "custom",
      "format": "{#90}╰────────────────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "{#90}╭─[{#1;35} 󰩟  NETWORK // PULSE {#90}]────────────────────────────╮"
    },
    {
      "type": "wifi",
      "key": "│ ├ Wi-Fi   ",
      "keyColor": "magenta",
      "format": "{ssid} {#90}({band} GHz • {protocol}) {#32}{signal-quality}"
    },
    {
      "type": "localip",
      "key": "│ ├󰩟 Local IP",
      "keyColor": "magenta",
      "compact": true
    },
    {
      "type": "uptime",
      "key": "│ ├󱫐 Uptime  ",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "│ └󱦟 OS Age  ",
      "keyColor": "magenta",
      "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days (Updated: $(omarchy-version-pkgs | awk '{print $2, $3}'))\""
    },
    {
      "type": "custom",
      "format": "{#90}╰────────────────────────────────────────────────────╯"
    }
  ]
}
