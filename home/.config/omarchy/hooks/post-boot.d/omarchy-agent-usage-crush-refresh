#!/usr/bin/env bash
# Refresh the omarchy.agents panel record for Crush every 15 minutes.
# Invoked from a post-boot hook; survives shell restarts because it
# detaches via setsid. omarchy-agent-usage-update only discovers
# collectors in $OMARCHY_PATH/bin/ (read-only), so the crush collector
# in ~/.local/bin/ runs on its own schedule.

set -euo pipefail

COLLECTOR="$HOME/.local/bin/omarchy-agent-usage-crush"
OUTPUT="$HOME/.local/state/omarchy/agents/usage/crush.json"
LOOP_FILE="$HOME/.cache/omarchy-agent-usage-crush-loop.sh"
PID_FILE="$HOME/.cache/omarchy-agent-usage-crush.pid"
INTERVAL=900

[[ -x $COLLECTOR ]] || exit 0

mkdir -p "$(dirname "$PID_FILE")"

# Skip if a loop is already running.
if [[ -f $PID_FILE ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  exit 0
fi

cat >"$LOOP_FILE" <<EOF
#!/usr/bin/env bash
trap 'rm -f "$PID_FILE"' EXIT
echo "\$\$" > "$PID_FILE"
while true; do
  tmp=\$(mktemp "\$OUTPUT.XXXXXX") && "\$COLLECTOR" > "\$tmp" 2>/dev/null && mv "\$tmp" "\$OUTPUT" || rm -f "\$tmp"
  sleep $INTERVAL || true
done
EOF
chmod +x "$LOOP_FILE"

setsid "$LOOP_FILE" </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
