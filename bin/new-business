#!/usr/bin/env bash
# new-business <name>: create ~/business/<name> from the business template.
# Not a git repo (it holds PDFs, contracts, tax papers). Back ~/business up
# to the cloud instead.
set -euo pipefail

TEMPLATES="$(cd "$(dirname "$(readlink -f "$0")")/../templates" && pwd)"

if [[ $# -lt 1 ]]; then
  echo "Usage: new-business <name>     e.g.  new-business \"Cleaning Supply\""
  exit 1
fi

name="$*"
slug=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
dest="$HOME/business/$slug"

if [[ -z $slug ]]; then echo "That name has no letters or numbers."; exit 1; fi
if [[ -e $dest ]]; then echo "Already exists: $dest"; exit 1; fi

mkdir -p "$HOME/business"
cp -r "$TEMPLATES/business" "$dest"
find "$dest" -name .gitkeep -delete
mkdir -p "$dest/finance/$(date +%Y)"

esc() { printf '%s' "$1" | sed 's/[\/&|]/\\&/g'; }
sed -i "s|{{BUSINESS_NAME}}|$(esc "$name")|g; s|{{DATE}}|$(date +%F)|g" "$dest/STATUS.md"

echo "Created ~/business/$slug"
echo "Logins for it go in KeePassXC under Business/$slug, never in this folder."
